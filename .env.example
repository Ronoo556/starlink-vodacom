# ── Starlink DRC — Environment Variables ──────────────────
# Copy this file to .env and fill in your values

# Flask
FLASK_ENV=production
SECRET_KEY=change-me-to-something-random-and-long

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=starlink_drc

# Full DB URL (alternative to above individual settings)
DATABASE_URL=mysql+pymysql://root:your_mysql_password@localhost/starlink_drc

# Telegram Bot
# 1. Create a bot via @BotFather on Telegram → get token
# 2. Add the bot to your group/channel → get chat ID
TELEGRAM_BOT_TOKEN=1234567890:ABCDefghIJKlmnOPQRstUVwxYZ
TELEGRAM_CHAT_ID=-1001234567890

# Telegram Webhook URL (your public URL + /telegram/webhook)
# Set with: curl -X POST https://api.telegram.org/bot<TOKEN>/setWebhook -d url=<WEBHOOK_URL>
WEBHOOK_URL=https://yourdomain.pythonanywhere.com/telegram/webhook
